#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.pid
*.log

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# 本地后端配置（勿提交，使用 config.example.yml 复制为 config.yml）
backend/config.yml
backend/config/config.yml
config/config.yml
config.yml

**/.DS_Store

.vscode

deploy
local

.idea
__debug*

# repo2txt 生成的项目快照（用于 LLM/RAG 上下文，不提交）
build/repo_dump.txt
build/tools/